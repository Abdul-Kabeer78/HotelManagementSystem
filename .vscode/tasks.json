{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-O2",
                "-Wall",
                "${workspaceFolder}/HotelManagementSystem.cpp",
                "-o",
                "${workspaceFolder}/HotelManagementSystem.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}
