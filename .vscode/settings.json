{
    "C_Cpp.default.includePath": [
        "${workspaceFolder}"
    ],
    "C_Cpp.default.defines": [
        "_DEBUG",
        "UNICODE",
        "_CONSOLE"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp_Runner.cCompilerPath": "cl",
    "C_Cpp_Runner.cppCompilerPath": "cl",
    "C_Cpp_Runner.debuggerPath": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\IDE\\devenv.exe",
    "C_Cpp_Runner.makePath": "nmake",
    "C_Cpp_Runner.warnings": [
        "-Wall",
        "-Wextra",
        "-Wpedantic"
    ],
    "C_Cpp_Runner.msvcSecureNoWarnings": true,
    "cSpell.ignoreWords": [
        "NDEBUG",
        "COMDAT",
        "iostream",
        "fstream",
        "iomanip",
        "MSVC",
        "SFML",
        "Kabeer"
    ],
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    }
}

